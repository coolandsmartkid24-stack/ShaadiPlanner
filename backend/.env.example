# ---- Supabase (the database) -------------------------------------------------------------
# Dashboard -> Connect -> Pooler -> Transaction mode (port 6543) gives you this string.
# Server only: it carries the database password, so it never reaches the browser.
# Name it DATABASE_URL (SUPABASE_DB_URL also works). On Vercel it lives in
# Settings -> Environment Variables - .env is not deployed.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# Session pooler alternative (port 5432, one session per client - fine locally):
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Optional: the IPv6-only direct connection string from the dashboard (used when IPv6 works).
# DATABASE_URL_DIRECT=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
SUPABASE_PROJECT_REF=
# Browser-safe key. Safe in the frontend only because every table has RLS enabled and no
# public policies (backend/schema.sql) - the app talks to the API, never to PostgREST.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only key for edge functions / privileged jobs. Never put this in the frontend.
SUPABASE_SECRET_KEY=sb_secret_...

# Who may call the API from a browser (comma separated). Vercel production + both Vite ports.
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173,http://localhost:5174

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
MAX_LLM_CALLS_PER_DAY=200
SHAADI_SECRET=change-me

# PayPak pass checkout (paybost.com) - from the merchant dashboard, API Key menu.
# PAYPAK_MODE=sandbox uses https://paybost.com/sandbox/payment/initiate, "live" the real one.
# Both keys must also be set on the deployment (Vercel -> Settings -> Environment Variables):
# .env is never uploaded, and without the keys /api/checkout answers 503 - a plan is NEVER
# granted without a confirmed payment.
PAYPAK_PUBLIC_KEY=
PAYPAK_SECRET_KEY=
PAYPAK_MODE=sandbox
# Offline UI work only: grant the plan without the gateway. Leave unset everywhere it matters.
# PAYPAK_DEV_GRANT=1
# Optional: the origin PayPak returns the browser to and posts the IPN to
# (defaults to the origin the request came from).
# APP_BASE_URL=https://yourdomain.com

# data files (defaults shown; uncomment to move them elsewhere)
# PLACES_JSON=backend/places.json
# DISCOVERED_PLACES_JSON=backend/discovered_places.json   (written at runtime to /tmp)
