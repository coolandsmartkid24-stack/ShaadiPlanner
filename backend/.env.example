OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
MAX_LLM_CALLS_PER_DAY=200
SHAADI_SECRET=change-me

# PayPak pass checkout (paybost.com) - from the merchant dashboard, API Key menu.
# PAYPAK_MODE=sandbox uses https://paybost.com/sandbox/payment/initiate, "live" the real one.
PAYPAK_PUBLIC_KEY=
PAYPAK_SECRET_KEY=
PAYPAK_MODE=sandbox
# Optional: the origin PayPak returns the browser to and posts the IPN to
# (defaults to the origin the request came from).
# APP_BASE_URL=https://yourdomain.com

# data files (defaults shown; uncomment to move them elsewhere)
# PLACES_JSON=../places.json
# DISCOVERED_PLACES_JSON=../discovered_places.json
# ENRICH_DB=./enrich_cache.sqlite
